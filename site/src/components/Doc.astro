---
// A text page: comparison, FAQ, guides. Same look as the privacy policy.
import "../styles/site.css";
import type { Lang } from "../i18n";
import Head from "./Head.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import Backdrop from "./Backdrop.astro";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The heading on the page; the <title> may say more. */
  h1: string;
  en: string;
  ru: string;
  ld?: object;
  /** A page of the user guide: its menu beside the text, no install button. */
  guide?: boolean;
}
const { lang, title, description, h1, en, ru, ld, guide } = Astro.props;
const url = (path: string) => import.meta.env.BASE_URL.replace(/\/$/, "") + path;
const p = lang === "en" ? "" : "/ru";
const install = lang === "en" ? "Install termchat.app" : "Установить termchat.app";
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head lang={lang} title={title} description={description} en={en} ru={ru} ld={ld} />
  </head>
  <body>
    <Backdrop />
    <header class="top">
      <Nav lang={lang} other={lang === "en" ? ru : en} />
    </header>
    <main class:list={["doc", { guide }]}>
      <slot name="aside" />
      <section>
        <h1>{h1}</h1>
        <slot />
        {!guide && <p class="more"><a class="button primary" href={url(`${p}/#install`)}>{install}</a></p>}
        <slot name="after" />
      </section>
    </main>
    <Footer lang={lang} other={lang === "en" ? ru : en} />
  </body>
</html>
