---
import "../styles/site.css";
import { REPO, SPONSOR, commands, texts, type Lang } from "../i18n";
import Cmd from "./Cmd.astro";
import Head from "./Head.astro";
import Footer from "./Footer.astro";

interface Props {
  lang: Lang;
}
const t = texts[Astro.props.lang];
// The site may live under a sub-path (GitHub Pages: /termchat/).
const url = (path: string) => import.meta.env.BASE_URL.replace(/\/$/, "") + path;
const blob = (path: string) => `${REPO}/blob/main/${path}`;
const p = t.lang === "en" ? "" : "/ru";
const groups = [
  ["ok", t.protected],
  ["part", t.partly],
  ["no", t.notProtected],
] as const;
// What search engines show about the app (schema.org).
const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "termchat.app",
  url: new URL(url(t.lang === "en" ? "/" : "/ru/"), Astro.site).href,
  description: t.description,
  applicationCategory: "CommunicationApplication",
  operatingSystem: "Linux, macOS, Windows, Android",
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  downloadUrl: `${REPO}/releases/latest`,
  sameAs: [REPO],
  inLanguage: t.lang,
};
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <Head lang={t.lang} title={t.title} description={t.description} en="/" ru="/ru/" ld={ld} />
  </head>
  <body>
    <canvas id="cipher" aria-hidden="true"></canvas>
    <div class="scanlines" aria-hidden="true"></div>

    <header class="top">
      <a class="brand" href={url(t.lang === "en" ? "/" : "/ru/")}><img src={url("/logo.svg")} alt="" width="26" height="26" /> termchat.app</a>
      <nav>
        <a href="#features">{t.nav.features}</a>
        <a href="#desktop">{t.nav.desktop}</a>
        <a href="#protection">{t.nav.protection}</a>
        <a href="#install">{t.nav.install}</a>
        <a href={url(`${p}/blog/`)}>{t.nav.blog}</a>
        <a href={REPO}>GitHub</a>
        <a class="lang" href={url(t.other.href)} hreflang={t.other.href === "/" ? "en" : "ru"}>{t.other.label}</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="badge">{t.status}</p>
        <div class="title">
          <img class="mark" src={url("/logo.svg")} alt="" width="112" height="112" />
          <p class="name glow" data-decrypt aria-label="termchat.app">termchat.app</p>
        </div>
        <h1 class="tagline">{t.tagline}</h1>
        <p class="lead">{t.lead}</p>
        <div class="cta">
          <a class="button primary" href="#install">{t.cta.install}</a>
          <a class="button" href={`${REPO}/releases/latest`}>{t.cta.download}</a>
          <a class="button" href={REPO}>{t.cta.github}</a>
        </div>

        <div class="terminal" role="img" aria-label="termchat.app in a terminal window">
          <div class="term-bar"><i></i><i></i><i></i><span>termchat.app</span></div>
          <div class="term-body">
            <div class="term-side">
              <p class="dim strong">contacts</p>
              <p class="row active"><b class="peach">!</b> alice·36335</p>
              <p class="row"><b class="mauve">●</b> bob<span class="count">2</span></p>
              <p class="row"><b class="yellow">?</b> carol·58121</p>
              <p class="foot dim"><span>+ add</span><span>≡ menu</span></p>
            </div>
            <div class="term-chat">
              <p class="term-head"><b>alice·36335</b> <span class="peach">! not verified (Ctrl+F)</span></p>
              <div class="msgs">
                <p><b class="mauve">alice·36335</b> <span class="dim">2m</span></p>
                <p>did the invite work?</p>
                <p class="gap"><b class="blue">you</b> <span class="dim">now</span></p>
                <p>yes, comparing safety numbers now <span class="dim">✓</span></p>
              </div>
              <p class="term-input"><b class="blue">›</b> <span class="typing">see you at 8</span><span class="caret"></span></p>
            </div>
          </div>
          <p class="term-status"><span class="green">● online via Tor</span> <span class="dim">you</span><span class="hints"><b>^P</b> menu <b>?</b> keys <b>^K</b> lock</span></p>
        </div>
        <div class="grid" aria-hidden="true"></div>
      </section>

      <section>
        <h2>{t.whatTitle}</h2>
        <div class="cards three">
          {t.what.map(([title, text]) => (
            <article class="card"><h3>{title}</h3><p>{text}</p></article>
          ))}
        </div>
      </section>

      <section id="features">
        <h2>{t.featuresTitle}</h2>
        <div class="cards">
          {t.features.map(([title, text]) => (
            <article class="card"><h3>{title}</h3><p>{text}</p></article>
          ))}
        </div>
      </section>

      <section id="desktop">
        <h2>{t.desktopTitle}</h2>
        <p class="sub">{t.desktopLead}</p>
        <figure class="window-shot">
          <img src={url("/desktop.png")} alt={t.desktopAlt} width="1100" height="700" loading="lazy" />
        </figure>
        <div class="cards">
          {t.desktop.map(([title, text]) => (
            <article class="card"><h3>{title}</h3><p>{text}</p></article>
          ))}
        </div>
        <p class="more"><a href="#install" data-tab="os-desktop">{t.desktopInstall} →</a></p>
      </section>

      <section id="protection">
        <h2>{t.protectionTitle}</h2>
        <p class="sub">{t.protectionLead}</p>
        <div class="cards three">
          {groups.map(([kind, g]) => (
            <article class={`card list ${kind}`}>
              <h3>{g.title}</h3>
              <ul>{g.items.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
        <p class="more"><a href={url(`${p}/threat-model/`)}>{t.threatModel} →</a> · <a href={url(`${p}/compare/`)}>{t.compareLink} →</a></p>
      </section>

      <section>
        <h2>{t.howTitle}</h2>
        <ol class="steps">
          {t.how.map(([title, text], i) => (
            <li><span class="num">0{i + 1}</span><h3>{title}</h3><p>{text}</p></li>
          ))}
        </ol>
      </section>

      <section id="install">
        <h2>{t.installTitle}</h2>
        <div class="tabs">
          <input type="radio" name="os" id="os-unix" checked />
          <label for="os-unix">{t.installTabs.unix}</label>
          <input type="radio" name="os" id="os-win" />
          <label for="os-win">{t.installTabs.windows}</label>
          <input type="radio" name="os" id="os-desktop" />
          <label for="os-desktop">{t.installTabs.desktop}</label>
          <input type="radio" name="os" id="os-android" />
          <label for="os-android">{t.installTabs.android}</label>
          <input type="radio" name="os" id="os-manual" />
          <label for="os-manual">{t.installTabs.manual}</label>

          <div class="panel" data-for="os-unix">
            <p>{t.install.brew}</p>
            <Cmd text={commands.brew} copy={t.copy} done={t.copied} />
            <p>{t.install.sh}</p>
            <Cmd text={commands.sh} copy={t.copy} done={t.copied} />
          </div>
          <div class="panel" data-for="os-win">
            <p>{t.install.ps}</p>
            <Cmd text={commands.ps} copy={t.copy} done={t.copied} />
            <p>{t.install.zip}</p>
          </div>
          <div class="panel" data-for="os-desktop">
            <p>{t.install.desktopBrew}</p>
            <Cmd text={commands.brewGui} copy={t.copy} done={t.copied} />
            <p>{t.install.desktopSh}</p>
            <Cmd text={commands.shGui} copy={t.copy} done={t.copied} />
            <p>{t.install.desktopPs}</p>
            <Cmd text={commands.psGui} copy={t.copy} done={t.copied} />
            <p class="dim">{t.install.desktopNote}</p>
          </div>
          <div class="panel" data-for="os-android">
            <p>{t.install.android}</p>
            <p><a class="button" href={`${REPO}/releases/latest`}>{t.install.releases}</a></p>
          </div>
          <div class="panel" data-for="os-manual">
            <p>{t.install.manual}</p>
            <p><a class="button" href={`${REPO}/releases/latest`}>{t.install.releases}</a></p>
          </div>
        </div>
        <p class="sub">{t.install.then}</p>
        <p class="more"><a href={blob(t.docs.verify)}>{t.install.verify} →</a></p>
      </section>

      <section>
        <h2>{t.relayTitle}</h2>
        <p class="sub">{t.relay}</p>
        <p class="more"><a href={url(`${p}/self-host/`)}>{t.relayLink} →</a></p>
      </section>

      <section id="sponsor">
        <h2>{t.sponsorTitle}</h2>
        <p class="sub">{t.sponsor}</p>
        <p class="more"><a class="button primary" href={SPONSOR}>♥ {t.sponsorLink}</a></p>
      </section>
    </main>

    <Footer lang={t.lang} />

    <script>
      import "../scripts/cipher";
      import "../scripts/copy";
    </script>
  </body>
</html>
